# Create a Sanity project at https://www.sanity.io/manage and fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Required for “Traducir al inglés” (Editor token in sanity.io/manage → API)
SANITY_API_WRITE_TOKEN=

# Translation — Google Gemini (free via AI Studio; primary for “Traducir al inglés”)
# Create a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional Gemini model backups (comma-separated; tried in order on failure)
# TRANSLATE_GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-flash-lite-latest

# Optional: Vercel AI Gateway (credit-based backup if Gemini is down)
# On Vercel, OIDC works automatically after linking the project.
# Locally: create a key in Vercel → AI Gateway, or run `vercel env pull`.
# AI_GATEWAY_API_KEY=
# TRANSLATE_MODELS=google/gemini-3.5-flash,google/gemini-3.1-flash-lite,openai/gpt-5-mini

# Legacy OpenAI-compatible fallback (optional)
# TRANSLATE_API_KEY=
# TRANSLATE_API_URL=https://ai-gateway.vercel.sh/v1/chat/completions

# Public site URL (must be the real https domain in production — not localhost)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
