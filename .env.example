# Create a Sanity project at https://www.sanity.io/manage and fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Optional: for write operations / translate action
SANITY_API_WRITE_TOKEN=
# Optional: used by /api/translate (OpenAI-compatible). Without it, a basic fallback is used in Studio.
TRANSLATE_API_KEY=
TRANSLATE_API_URL=https://api.openai.com/v1/chat/completions
TRANSLATE_MODEL=gpt-4o-mini
NEXT_PUBLIC_SITE_URL=http://localhost:3000
