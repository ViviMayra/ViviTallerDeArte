# Create a Sanity project at https://www.sanity.io/manage and fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Required for “Traducir al inglés” (Editor token in sanity.io/manage → API)
SANITY_API_WRITE_TOKEN=

# Translation (Vercel AI Gateway — recommended)
# On Vercel, OIDC works automatically after linking the project.
# Locally: create a key in Vercel → AI Gateway, or run `vercel env pull`.
AI_GATEWAY_API_KEY=
# Optional overrides (comma-separated provider/model slugs; tried in order)
# TRANSLATE_MODELS=openai/gpt-5-mini,google/gemini-2.5-flash,anthropic/claude-haiku-4.5

# Legacy OpenAI-compatible fallback (optional if AI Gateway is set)
# TRANSLATE_API_KEY=
# TRANSLATE_API_URL=https://ai-gateway.vercel.sh/v1/chat/completions
# TRANSLATE_MODEL=openai/gpt-5-mini

NEXT_PUBLIC_SITE_URL=http://localhost:3000
